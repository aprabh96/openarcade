#!/usr/bin/env php
<?php

declare(strict_types=1);

require __DIR__ . '/../vendor/autoload.php';

use OpenArcade\Console\Application;
use OpenArcade\Console\Doctor;
use OpenArcade\Db\Connection;
use OpenArcade\Http\Drivers;
use OpenArcade\Support\Config;
use OpenArcade\Support\CurlHttpClient;
use OpenArcade\Support\Logger;
use OpenArcade\Support\SystemClock;

$root = dirname(__DIR__);
$config = Config::load($root);
$command = $argv[1] ?? 'help';

$pdo = null;
$databaseError = null;
try {
    $pdo = Connection::fromConfig($config);
} catch (\Throwable $error) {
    $databaseError = $error->getMessage();
}

if ($command === 'doctor') {
    $results = (new Doctor(
        $config,
        $pdo,
        $databaseError,
        $root . '/migrations',
        new CurlHttpClient(),
        in_array('--online', $argv, true),
    ))->run();
    $failed = Doctor::hasFailures($results);
    if (in_array('--json', $argv, true)) {
        echo json_encode(['ok' => !$failed, 'checks' => $results], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . "\n";
    } else {
        foreach ($results as $result) {
            printf("%-5s %-34s %s\n", strtoupper($result['status']), $result['check'], $result['detail']);
        }
        echo $failed ? "\nSomething needs attention: fix every FAIL line above and run doctor again.\n" : "\nAll checks passed.\n";
    }
    exit($failed ? 1 : 0);
}

if ($pdo === null) {
    fwrite(STDERR, "Cannot connect to the database. Check DB_* in .env. {$databaseError}\nRun: php bin/console doctor\n");
    exit(2);
}
$logger = new Logger($root . '/storage/logs/app.log');
try {
    $gateway = Drivers::gateway($config, $logger);
} catch (\Throwable $error) {
    fwrite(STDERR, 'Payment settings are incomplete: ' . $error->getMessage() . "\n");
    exit(2);
}

exit((new Application($pdo, $root . '/migrations', new SystemClock(), static function (string $line): void {
    echo $line . "\n";
}, $gateway, $logger))->run($argv));

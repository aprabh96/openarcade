# Copy to .env and fill in. Never commit .env. Keep this file outside the web root.
APP_ENV=production
APP_DEBUG=false
# Public address of this installation, without a trailing slash.
APP_URL=https://booking.example.com
# 32+ random characters. Generate: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# none = customers pay at the venue. square = charge the card during booking.
PAYMENT_MODE=none
SQUARE_ENV=sandbox
SQUARE_ACCESS_TOKEN=
SQUARE_APPLICATION_ID=
SQUARE_LOCATION_ID=

# none = no station commands. pusher = send START_SESSION / STOP_SESSION / ADD_TIME to station clients.
REALTIME_DRIVER=none
PUSHER_APP_ID=
PUSHER_KEY=
PUSHER_SECRET=
PUSHER_CLUSTER=us2

# log = write emails to storage/logs/mail.log. mail = PHP mail(). smtp = an SMTP account.
MAIL_DRIVER=log
MAIL_FROM_ADDRESS=bookings@example.com
MAIL_FROM_NAME="Example VR"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls

# Sites allowed to embed the booking page in an iframe, comma separated. Leave empty for none.
EMBED_ALLOWED_ORIGINS=

# Only when the app runs behind a reverse proxy or load balancer that sets X-Forwarded-For.
TRUST_PROXY=false
SESSION_IDLE_MINUTES=480

# Shared hosting without SSH only: set to a long random value, open /setup.php?token=..., then remove it.
SETUP_TOKEN=
